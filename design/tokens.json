{
  "name": "Selah Live Design System",
  "version": "1.0.0",
  "colors": {
    "dark": {
      "bg-900": "#0B1020",
      "bg-800": "#121A2E",
      "bg-700": "#1B2540",
      "bg-600": "#243257",
      "border": "#2A3558",
      "text-primary": "#F4F6FB",
      "text-secondary": "#A9B3CF",
      "accent-gold": "#E8B84A",
      "accent-gold-hover": "#FFD57E",
      "accent-blue": "#5B8CFF",
      "success": "#3DDC97",
      "warning": "#F5A524",
      "danger": "#FF5C70",
      "on-gold": "#0B1020"
    },
    "light": {
      "bg-900": "#F7F8FC",
      "bg-800": "#FFFFFF",
      "bg-700": "#EEF1F9",
      "bg-600": "#E3E8F5",
      "border": "#D3DAEC",
      "text-primary": "#0B1020",
      "text-secondary": "#4B5675",
      "accent-gold": "#C8922A",
      "accent-gold-hover": "#E8B84A",
      "accent-blue": "#5B8CFF",
      "success": "#3DDC97",
      "warning": "#F5A524",
      "danger": "#FF5C70",
      "on-gold": "#0B1020"
    },
    "overlay": {
      "defaultBg": "#0B1020",
      "presets": ["#0B1020", "#12264A", "#2B1740", "#143A2E", "#3A1A1A", "#1A1A1A"],
      "text": "#FFFFFF",
      "reference": "#E8B84A"
    }
  },
  "typography": {
    "fontFamily": {
      "heading": "\"Outfit\", \"Poppins\", system-ui, sans-serif",
      "body": "\"Inter\", system-ui, sans-serif",
      "mono": "\"JetBrains Mono\", ui-monospace, monospace"
    },
    "scalePx": [12, 14, 16, 20, 24, 32, 48],
    "overlayScalePx": {
      "lowerThirdBody": { "min": 26, "default": 52, "max": 72 },
      "lowerThirdRef": 32,
      "fullScreenBody": { "min": 36, "default": 84, "max": 96 },
      "fullScreenRef": 40
    }
  },
  "radius": {
    "panel": "12px",
    "control": "10px",
    "chip": "999px",
    "overlayLowerThird": "16px"
  },
  "spacing": {
    "grid": 8,
    "stepsPx": [8, 16, 24, 32, 48, 72]
  },
  "motion": {
    "uiTransition": "150ms ease-out",
    "overlayEntrance": "400ms ease-out",
    "overlayExit": "300ms ease-in"
  },
  "layout": {
    "designWindow": { "width": 1280, "height": 800 },
    "minWindow": { "width": 1000, "height": 650 },
    "topBarHeight": 56,
    "leftNavWidth": 200,
    "rightPreviewWidth": 360,
    "dockWidth": { "min": 320, "default": 380, "max": 420 },
    "overlayStage": { "width": 1920, "height": 1080 }
  }
}

