{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "src/shared/**/*.ts",
    "src/shared/**/*.tsx",
    "src/modules/**/*.ts",
    "src/modules/**/*.tsx",
    "src/server/**/*.ts",
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/tests/**/*.ts",
    "src/tests/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
